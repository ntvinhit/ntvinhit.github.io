---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Language of the page content. The UI shell itself stays English. */
  lang?: 'en' | 'vi';
}

const { title, description = 'Personal blog and mirrored X articles.', lang = 'en' } =
  Astro.props;

const siteName = 'Vinh N.T.';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/references/', label: 'References' },
  { href: '/posts/', label: 'Posts' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} · ${siteName}` : `${siteName} — personal blog`}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="sticky top-0 z-10 border-b border-line bg-paper/85 backdrop-blur dark:border-line-dark dark:bg-paper-dark/85">
      <nav
        class="mx-auto flex w-full max-w-3xl items-center justify-between gap-6 px-4 py-4"
        aria-label="Primary"
      >
        <a
          href="/"
          class="font-semibold tracking-tight text-ink no-underline dark:text-ink-dark"
          >{siteName}</a
        >
        <ul class="flex items-center gap-5 text-sm">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'no-underline transition-colors',
                    Astro.url.pathname.startsWith(item.href) &&
                      item.href !== '/' &&
                      'font-medium text-ink dark:text-ink-dark',
                    Astro.url.pathname === item.href &&
                      'font-medium text-ink dark:text-ink-dark',
                  ]}
                  >{item.label}</a
                >
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-10">
      <slot />
    </main>

    <footer class="border-t border-line dark:border-line-dark">
      <p class="mx-auto w-full max-w-3xl px-4 py-6 text-center text-sm text-muted dark:text-muted-dark">
        © {new Date().getFullYear()} Vinh N.T. — Built with Astro, Bun &amp;
        Tailwind CSS.
      </p>
    </footer>
  </body>
</html>
