# X API credentials for the add-reference script (scripts/add-reference.ts).
#
# Copy this file to `.env` and fill in your Bearer token:
#   cp .env.example .env
#   (edit .env, set X_API_BEARER_TOKEN)
#
# Get a token at https://developer.x.com/ (Project → Keys & tokens → Bearer Token).
# Bun auto-loads `.env` — no code changes needed.
#
# `.env` is gitignored — never commit it. This example file is safe to commit.

X_API_BEARER_TOKEN=
